[run]
source =
    modules
    launcher
    src
omit =
    */tests/*
    */__init__.py
    */generated/*
    */migrations/*
    */venv/*
    */.venv/*
    */setup.py
    */config/*
    */docs/*
    */tools/*

[report]
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
    raise NotImplementedError
    except ImportError
    if TYPE_CHECKING

show_missing = True
skip_covered = True
precision = 2
